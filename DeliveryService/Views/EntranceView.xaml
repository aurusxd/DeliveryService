<Window x:Class="DeliveryService.Views.EntranceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeliveryManager" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen" 
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <Border Background="#F9FAFB" CornerRadius="24" BorderBrush="#E5E7EB" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2563EB" CornerRadius="24,0,0,24" Padding="40">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🚚" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="DeliveryManager" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <Border Margin="0,50,0,0" CornerRadius="12" Background="#1D4ED8" Padding="15">
                        <TextBlock Text="Войдите или зарегистрируйтесь, чтобы начать работу" Foreground="#DBEAFE" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="60,0">
                <StackPanel VerticalAlignment="Center">

                    <Border HorizontalAlignment="Center" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="ВХОД" Style="{StaticResource TabButtonStyle}"/>
                            <Button Content="РЕГИСТРАЦИЯ" Style="{StaticResource TabButtonStyle}" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Добро пожаловать" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="#374151" 
                               HorizontalAlignment="Center" 
                               Margin="0,20,0,40"/>

                    <TextBlock Text="ЛОГИН" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <TextBox Name="NameTextBox" Text="{Binding CourierName}" Style="{StaticResource ModernFieldTextBox}" Margin="0,0,0,25"/>

                    <TextBlock Text="ПАРОЛЬ" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <TextBox Name="PhoneTextBox" Text="{Binding CourierPhone}" Style="{StaticResource ModernFieldTextBox}" Margin="0,0,0,40"/>

                    <Button Content="ВОЙТИ" Style="{StaticResource PrimaryButton}" Height="50" Margin="0,0,0,15"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
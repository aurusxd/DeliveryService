<Window x:Class="DeliveryService.Views.EntranceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeliveryManager" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen" 
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <Border Background="#F9FAFB" CornerRadius="24" BorderBrush="#E5E7EB" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2563EB" CornerRadius="24,0,0,24" Padding="40">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🚚" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="DeliveryManager" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <Border Margin="0,50,0,0" CornerRadius="12" Background="#1D4ED8" Padding="15">
                        <TextBlock Text="Войдите или зарегистрируйтесь, чтобы начать работу" Foreground="#DBEAFE" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
            

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Bottom" >
                    <Border HorizontalAlignment="Center" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="ВХОД" Style="{StaticResource TabButtonStyle}" Command="{Binding LoginCommand}"/>
                            <Button Content="РЕГИСТРАЦИЯ" Style="{StaticResource TabButtonStyle}" Command="{Binding RegCommand}" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <ContentControl Grid.Column="1" Padding="60,0" Content="{Binding CurrentView}"/>
                </StackPanel>
            </Grid>   
        </Grid>
    </Border>
</Window>
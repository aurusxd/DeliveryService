<Window x:Class="DeliveryService.Views.OrderAcceptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:DeliveryService.Views"
        mc:Ignorable="d"
        Title="OrderAcceptView" Height="800" Width="1200" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Топбар -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть — статус -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Иконка галочки -->
                    <Border Width="44" Height="44" CornerRadius="22"
                            Background="#DCFCE7" Margin="0,0,14,0">
                        <TextBlock Text="✓" FontSize="22" FontWeight="Bold"
                                   Foreground="#16A34A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ваш заказ принят!"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="#111827"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13" Foreground="#6B7280"
                                   Margin="0,2,0,6"/>
                        <!-- Чипы -->
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#EFF6FF" CornerRadius="10"
                                    BorderBrush="#BFDBFE" BorderThickness="1"
                                    Padding="10,3" Margin="0,0,8,0">
                                <TextBlock Text="{Binding OrderNumber}"
                                           FontSize="12" Foreground="#1D4ED8"/>
                            </Border>
                            <Border Background="#F3F4F6" CornerRadius="10"
                                    BorderBrush="#E5E7EB" BorderThickness="1"
                                    Padding="10,3">
                                <TextBlock Text="{Binding Status}"
                                           FontSize="12" Foreground="#374151"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,0,0">

                    <Border Background="White" CornerRadius="12"
                            BorderBrush="#E5E7EB" BorderThickness="1"
                            Padding="16,12" Margin="0,0,12,0" MinWidth="220">
                        <StackPanel>
                            <TextBlock Text="МАРШРУТ" FontSize="11"
                                       Foreground="#9CA3AF" Margin="0,0,0,8"
                                       />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="8" Height="8" Fill="#22C55E"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding AddressFrom}"
                                           FontSize="13" Foreground="#374151"/>
                            </StackPanel>
                            <Rectangle Width="1" Height="12" Fill="#E5E7EB"
                                       HorizontalAlignment="Left" Margin="3,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#EF4444"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding AddressTo}"
                                           FontSize="13" Foreground="#374151"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="← Вернуться"
                            Command="{Binding ReturnCommand}"
                            Height="44" Padding="20,0"
                            Background="#2563EB" Foreground="White"
                            BorderThickness="0" FontSize="14"
                            FontWeight="Medium">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Карта -->
        <wv:WebView2 Name="Map" Grid.Row="1"/>
    </Grid>
</Window>
